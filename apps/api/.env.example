# Copy thành .env rồi sửa giá trị
PORT=4000
MONGODB_URI=mongodb://localhost:27017/qcc_agency
# Địa chỉ frontend, dùng cho CORS (cookie đăng nhập)
WEB_ORIGIN=http://localhost:3000
# Đổi thành chuỗi ngẫu nhiên dài khi chạy thật
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# true khi chạy HTTPS (production)
COOKIE_SECURE=false
